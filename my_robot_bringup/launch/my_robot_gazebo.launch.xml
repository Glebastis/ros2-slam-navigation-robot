<launch>
    <let name="urdf_path" 
         value="$(find-pkg-share my_robot_description)/urdf/my_robot.urdf.xacro" />

    <let name="rviz_config_path"
         value="$(find-pkg-share my_robot_bringup)/rviz/urdf_config.rviz" />

    <include file="$(find-pkg-share gazebo_ros)/launch/gazebo.launch.py">
          <arg name="world" value="$(find-pkg-share my_robot_bringup)/worlds/test_world.world" />
    </include>

    <timer period="3.0">
        <node pkg="robot_state_publisher" exec="robot_state_publisher">
            <param name="robot_description" value="$(command 'xacro $(var urdf_path)')" />
            <param name="use_sim_time" value="true" />
        </node>
    </timer>

    <timer period="4.0">
        <node pkg="gazebo_ros" exec="spawn_entity.py"
              args="-topic robot_description -entity my_robot">
            <param name="use_sim_time" value="true" />
        </node>
    </timer>

    <timer period="5.0">
        <node pkg="depthimage_to_laserscan" exec="depthimage_to_laserscan_node"
              name="depthimage_to_laserscan" output="screen">
            <remap from="depth" to="/depth_camera/depth/image_raw" />
            <remap from="depth_camera_info" to="/depth_camera/depth/camera_info" />
            <remap from="scan" to="/scan" />
            <param name="use_sim_time" value="true" />
            <param name="output_frame" value="footprint_link" />
            <param name="scan_height" value="100" />
            <param name="scan_time" value="0.033" />
            <param name="range_min" value="0.05" />
            <param name="range_max" value="3.0" />
        </node>
    </timer>

    <let name="slam_params_path"
         value="$(find-pkg-share my_robot_bringup)/config/slam_params.yaml" />

    <timer period="6.0">
        <node pkg="slam_toolbox" exec="async_slam_toolbox_node"
              name="slam_toolbox" output="screen">
            <param from="$(var slam_params_path)" />
            <param name="use_sim_time" value="true" />
        </node>
    </timer>

      <!-- <timer period="6.0">
      <node pkg="slam_toolbox" exec="async_slam_toolbox_node"
            name="slam_toolbox" output="screen"
            args="ros-args log-level debug">
            <param from="$(var slam_params_path)" />
            <param name="use_sim_time" value="true" />
      </node>
      </timer> -->

    <timer period="6.0">
        <node name="rviz2" exec="rviz2" output="screen"
              args="-d $(var rviz_config_path)">
            <param name="use_sim_time" value="true" />
        </node>
    </timer>
</launch>